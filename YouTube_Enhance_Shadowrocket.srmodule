#!name=YouTube Enhance (Shadowrocket)
#!desc=YouTube / YouTube Music：去广告、后台播放、画中画；Shadowrocket 兼容版
#!author=Maasea (upstream) / Shadowrocket compatibility update
#!homepage=https://github.com/Maasea/sgmodule
#!upstream=https://raw.githubusercontent.com/Maasea/sgmodule/master/YouTube.Enhance.sgmodule
#!note=需开启 HTTPS 解密（MITM）并安装/信任 Shadowrocket CA 证书；已加入 UDP/QUIC 降级规则以确保锁屏后台播放请求可被脚本处理。

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
# 固定参数：captionLang=off，blockUpload=true，blockImmersive=true，blockShorts=false，debug=false
youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js, argument="{\"captionLang\":\"off\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"debug\":false}"

youtube.request.init = type=http-request, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, argument="{\"captionLang\":\"off\"}"

youtube.request.log_event = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, requires-body=1, max-size=-1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, argument="{\"captionLang\":\"off\"}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com
