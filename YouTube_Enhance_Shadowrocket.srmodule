#!name=YouTube Enhance (Shadowrocket)
#!desc=YouTube / YouTube Music：去广告、后台播放、画中画；由 Maasea YouTube.Enhance.sgmodule 转为 Shadowrocket 固定参数版
#!author=Maasea (upstream) / Shadowrocket conversion
#!homepage=https://github.com/Maasea/sgmodule
#!upstream=https://raw.githubusercontent.com/Maasea/sgmodule/master/YouTube.Enhance.sgmodule
#!note=需开启 HTTPS 解密（MITM）并安装/信任 Shadowrocket CA 证书。上游主要按 Surge 测试，Shadowrocket 兼容性取决于当前版本与 YouTube 接口变化。

[Script]
# 固定参数：
# captionLang=off
# blockUpload=true
# blockImmersive=true
# blockShorts=false
# debug=false

youtube.response = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$, requires-body=true, max-size=-1, binary-body-mode=true, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js, argument="{\"captionLang\":\"off\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"debug\":false}"

youtube.request.init = type=http-request, pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*, requires-body=true, max-size=-1, binary-body-mode=true, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, argument="{\"captionLang\":\"off\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"debug\":false}"

youtube.request.log_event = type=http-request, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event, requires-body=true, max-size=-1, binary-body-mode=true, script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js, argument="{\"captionLang\":\"off\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"debug\":false}"

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
